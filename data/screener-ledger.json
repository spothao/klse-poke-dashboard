  "scoring_detail": "Each metric converted to percentile rank (0-1) among names passing filters; financials get 0.5 for the D/E rank. Composite = weighted sum.",
  "tie_break": "higher 20-day avg traded value, then lower P/E",
  "refresh": "First trading day of each week (14 Oct, 19 Oct, 26 Oct, 2 Nov, 10 Nov 2026), using data up to that day's close.",
  "trading_rules": {
   "buy": "Each trading day: buy 1 lot (100 sh) at the close of the highest-ranked current top-20 name not held that (a) is affordable from cash, (b) keeps sector count <= 2, (c) has a 5-day return > -5% (no falling knives). Up to 2 buys per day. Once 10 names are held, extra cash adds 1 lot to the highest-ranked held name with position value under 15% of portfolio.",
   "sell": "Sell whole position at the close if (a) at a weekly refresh it ranks outside the top 30 or fails filters, or (b) close <= 90% of average cost (stop-loss), or (c) red-flag news (none applied in backfill).",
   "other": "100-share board lots, closing price, no fees, no shorting/margin, cash rolls over."
  }
 },
